# Handle line endings automatically for text files
* text=auto

# Force LF line endings for all text files upon checkout
* text eol=lf

# Explicitly ensure bash/shell scripts use LF
*.sh text eol=lf

# Keep Windows-specific files as CRLF if necessary
*.bat text eol=crlf

# Denote binary files (so Git doesn't modify their line endings)
*.png binary
*.jpg binary
